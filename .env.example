# Copy to .env and adjust for your machine.

ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=postgresql+asyncpg://setu:setu@localhost:5432/setu
DATABASE_ECHO=false

# Redpanda's external listener; use redpanda:9092 from inside the compose network.
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
OUTBOX_POLL_INTERVAL_SECONDS=2.0
OUTBOX_BATCH_SIZE=50

STORAGE_LOCAL_PATH=./data/storage

# LLMPlanner (Phase 4) -- Groq API key, and a model on Groq's
# structured-outputs supported-models list.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# find_content (semantic search) uses the same key against a vision model.
# Everything below has a working default in backend/core/config.py and is
# listed here only because the rate limit is a real setup surprise:
# measured on the free tier, an image costs ~2,786 tokens against the
# 8,000 tokens-per-minute budget (it *bills* only ~845 -- the two are
# accounted separately), which is under three frames a minute. A search is
# therefore a background job on that tier, not an interactive one.
#
# VISION_MAX_FRAMES is the dial: it caps what any single search can cost,
# at the price of sampling long videos more coarsely. Raise
# VISION_FRAMES_PER_REQUEST to 3 (the model's own maximum) and
# VISION_REQUEST_CONCURRENCY above 1 only on a tier with the TPM headroom
# -- on the free tier a 3-image request is rejected outright.
# VISION_MAX_FRAMES=150
# VISION_FRAMES_PER_REQUEST=2
# VISION_REQUEST_CONCURRENCY=1
