# This repo is a monorepo: backend/ and frontend/ each carry their own
# .gitignore for project-specific rules. This one is a defensive backstop
# for anything that ends up at the repo root instead.

# Secrets / local environment
.env
.env.*
!.env.example
*.local

# Agent scratch state
.claude/

# Editor / OS state
.vscode/
.idea/
.cph/
.DS_Store

# Python artifacts, in case any linger outside backend/
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node artifacts, in case any linger outside frontend/
node_modules/
dist/

# Local-disk storage backend's leftover output at the old root path
/data/

# Pre-restructure scratch notes, left behind at the old root path
/ontofrontend.md
